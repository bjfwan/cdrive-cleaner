  {
    "id": "json_nvidia_shader_cache",
    "app_id": "nvidia",
    "detect": ["%LOCALAPPDATA%\\NVIDIA\\DXCache", "%LOCALAPPDATA%\\NVIDIA\\GLCache"],
    "category": "installer_cache",
    "name": "NVIDIA 着色器缓存",
    "description": "NVIDIA DX/GL/Compute 着色器缓存，删除后会自动重建",
    "targets": [
      {
        "base": "%LOCALAPPDATA%\\NVIDIA",
        "subdirs": ["DXCache", "GLCache", "ComputeCache"]
      }
    ],
    "risk": "safe",
    "requires_admin": false,
    "default_selected": true,
    "clean_subdirs_only": false,
    "why_safe": "NVIDIA DirectX / OpenGL / Compute 着色器编译缓存。删除后游戏 / 渲染程序首次运行时会重新编译着色器（首场景慢 1-3 秒），不会影响驱动、游戏存档或显卡设置。"
  }
