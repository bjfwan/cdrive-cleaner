  {
    "id": "json_npm_cache",
    "app_id": "npm",
    "detect": ["%APPDATA%\\npm-cache"],
    "category": "dev_cache",
    "name": "npm 全局缓存",
    "description": "npm 下载缓存，删除后下次构建需重新下载",
    "targets": [
      {
        "base": "%APPDATA%\\npm-cache"
      }
    ],
    "risk": "risky",
    "requires_admin": false,
    "default_selected": false,
    "clean_subdirs_only": false,
    "why_safe": "npm 下载过的包压缩包副本。默认不勾：删了不会影响已安装的依赖（在 node_modules），但下次 npm install 没命中本地缓存就要重新从 registry 下载，速度慢一些。"
  },
