[
  {
    "id": "json_chrome_cache",
    "app_id": "chrome",
    "detect": ["%LOCALAPPDATA%\\Google\\Chrome\\User Data"],
    "category": "browser_cache",
    "name": "Chrome 网页缓存",
    "description": "Chrome 所有配置的网页缓存，删除后首次访问会重新下载",
    "targets": [
      {
        "base": "%LOCALAPPDATA%\\Google\\Chrome\\User Data",
        "subdirs": ["Default\\Cache", "Default\\Code Cache", "Default\\GPUCache"]
      }
    ],
    "risk": "safe",
    "requires_admin": false,
    "default_selected": true,
    "clean_subdirs_only": false
  },
