  {
    "id": "json_windows_temp",
    "app_id": "windows_system",
    "detect": ["%WINDIR%\\Temp"],
    "category": "system_temp",
    "name": "Windows 系统临时文件",
    "description": "系统 Temp 目录，安装/更新中产生的中转文件",
    "targets": [
      {
        "base": "%WINDIR%\\Temp"
      }
    ],
    "risk": "caution",
    "requires_admin": true,
    "default_selected": true,
    "clean_subdirs_only": true,
    "why_safe": "Windows 系统服务和安装程序留下的中转文件，正常运行的进程不会回头读这里。删除不影响你的任何已装软件、Windows Update 进度、用户文档或系统配置。"
  },
