[
  {
    "id": "discord_cache",
    "app_id": "discord",
    "detect": ["%APPDATA%\\discord"],
    "category": "app_cache",
    "name": "Discord 缓存",
    "description": "Discord 桌面端 Electron 缓存,可安全删除",
    "targets": [
      {"base": "%APPDATA%\\discord\\Cache\\Cache_Data"},
      {"base": "%APPDATA%\\discord\\Code Cache"},
      {"base": "%APPDATA%\\discord\\GPUCache"}
