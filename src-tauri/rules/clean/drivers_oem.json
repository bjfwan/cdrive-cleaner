  },
  {
    "id": "nvidia_nv_cache",
    "app_id": "nvidia",
    "detect": ["%PROGRAMDATA%\\NVIDIA Corporation\\NV_Cache"],
    "category": "app_cache",
    "name": "NVIDIA NV_Cache",
    "description": "NVIDIA 驱动的系统级着色器缓存",
    "targets": [{"base": "%PROGRAMDATA%\\NVIDIA Corporation\\NV_Cache"}],
    "risk": "safe",
    "requires_admin": true,
    "default_selected": true,
    "clean_subdirs_only": true,
    "why_safe": "NVIDIA 驱动为加速 OpenGL/Vulkan 程序启动而保存的编译后着色器缓存。删了不影响游戏存档、画质设置和驱动配置,只会让最近玩过的游戏首次启动时再编译一次 shader,可能多花几秒到十几秒,之后恢复正常。"
  },
  {
