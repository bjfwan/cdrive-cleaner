[
  {
    "id": "nvidia_corp_logs",
    "app_id": "nvidia",
    "detect": ["%PROGRAMDATA%\\NVIDIA Corporation"],
    "category": "app_logs",
    "name": "NVIDIA Corporation 日志",
    "description": "NVIDIA 各组件的运行日志文件",
