      {"base": "%PROGRAMDATA%\\NVIDIA Corporation\\Downloader\\log"}
    ],
    "risk": "safe",
    "requires_admin": true,
    "default_selected": true,
    "clean_subdirs_only": false,
    "max_depth": 3,
    "why_safe": "NVIDIA 遥测组件和驱动下载器的运行日志。删了不影响驱动本身、显卡控制面板和 NVIDIA App,显卡照常工作。仅当你正在排查 GeForce Experience/驱动安装异常想找线索时,日志才有用。"
  },
  {
    "id": "nvidia_downloader",
    "app_id": "nvidia",
    "detect": ["%PROGRAMDATA%\\NVIDIA Corporation\\Downloader"],
    "category": "installer_cache",
    "name": "NVIDIA 下载器缓存",
    "description": "NVIDIA 驱动下载器的缓存安装包",
    "targets": [{"base": "%PROGRAMDATA%\\NVIDIA Corporation\\Downloader"}],
    "risk": "safe",
    "requires_admin": true,
    "default_selected": true,
    "clean_subdirs_only": true,
